<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Chord detection is the whole app; without a microphone there is nothing to run. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrystalBall">

        <!--
            Not a service that ever runs — it is disabled, and exists only to carry the meta-data
            below. That flag is how AppCompat is told to persist the language chosen in Settings.

            Without it the choice survives only until the process dies. Android 13 and up hides
            that: there the framework stores the per-app language itself, so the bug is invisible
            on a modern device and shows up only on 8 to 12 — which is the entire span AppCompat
            was added for.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lends the chord sheet to whichever app the share sheet lands on. Sharing needs a uri
            another process may read, and a file:// one is refused outright since Android 7 — this
            hands out a content:// uri instead, scoped to one cache directory and read-only for as
            long as the receiving app holds the grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
