    <!-- ===== Shapes and grips ===== -->

    <!--
      The caption under a chord diagram: where the grip sits, then which shape it is.
      %1$s is voicing_open or voicing_fret, %2$s is one of the shape_* strings.
    -->
    <string name="voicing_caption">%1$s · %2$s</string>
    <string name="voicing_open">open</string>
    <!--
      Which fret the grip is named after, as an ordinal. An ICU pattern rather than a plain
      placeholder, because the ordinal is not "the number plus a suffix" in every language: English
      needs four branches (1st, 2nd, 3rd, 5th), German only one ("5."). Add or drop branches to suit
      the language — the platform picks the right one.

      "selectordinal" and not "ordinal": the latter is ICU's spell-out formatter, which quietly
      ignores the branches below and prints the bare "3rd", losing the noun.
    -->
    <string name="voicing_fret">{0, selectordinal, one{#st fret} two{#nd fret} few{#rd fret} other{#th fret}}</string>
    <!-- %1$s is the open chord this grip transposes — a symbol, e.g. Em or A7. -->
    <string name="shape_grip">%1$s shape</string>
    <!--
      A grip with no open chord to be named after, named by the string its root sits on. An ICU
      ordinal for the same reason as voicing_fret above; {0} counts the way players do, so the low
      E is the 6th string.
    -->
    <string name="shape_root_string">{0, selectordinal, one{#st-string root} two{#nd-string root} few{#rd-string root} other{#th-string root}}</string>
    <string name="shape_top_triad">top triad</string>
    <string name="shape_middle_triad">middle triad</string>

    <!--
      The second name under a chord, when a capo makes the chord you hear and the chord you finger
      different things. %1$s is a chord name, %2$s a shape.
    -->
    <string name="shape_line_fingered">%1$s, %2$s</string>
    <string name="shape_line_sounds">sounds as %1$s</string>
    <!-- %1$s is one of the two lines above, %2$d the capo fret. -->
    <string name="shape_line_with_capo">%1$s · capo %2$d</string>

